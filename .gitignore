# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Rewritten by every `tsc --noEmit`, so it churns on every typecheck.
tsconfig.tsbuildinfo

# Env
.env*.local

# Editor/OS
.DS_Store

# Generated data payloads (regenerated by `scripts/fetch-data.mjs`, run
# automatically before `next build`). These total ~10-12 MB and change on
# whatever schedule the upstream analytics pipeline runs on, so they are not
# tracked — a small, representative snapshot of each is committed instead
# under public/data/fallback/ (this pattern only matches direct children of
# public/data/, so that directory is unaffected). See the header comment in
# scripts/fetch-data.mjs for the full fallback chain.
/public/data/*.json
