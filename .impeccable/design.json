      "description": "The search submit and the contributing-guide action.",
      "html": "<button class=\"ds-pill-blue\" type=\"button\">Search</button>",
      "css": ".ds-pill-blue{display:inline-flex;align-items:center;min-height:52px;padding:0 24px;border:2px solid #1878cf;border-radius:999px;background:#1878cf;color:#fff;font-family:var(--font-body,'Helvetica Neue',Arial,sans-serif);font-size:15px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;cursor:pointer;transition:transform .15s ease,background-color .15s ease}.ds-pill-blue:hover{transform:translateY(-1px);background:#145e9c;border-color:#145e9c}.ds-pill-blue:focus-visible{outline:2px solid #1878cf;outline-offset:2px}"
    },
    {
      "name": "Mint Pill",
      "kind": "button",
      "refersTo": "pill-mint",
      "description": "Reserved for the contribute invitation: Add a project, Find an issue.",
      "html": "<a class=\"ds-pill-mint\" href=\"#\">Add a project</a>",
      "css": ".ds-pill-mint{display:inline-flex;align-items:center;min-height:44px;padding:0 20px;border:2px solid var(--color-black,#13262b);border-radius:999px;background:#47f6ad;color:#13262b;font-family:var(--font-body,'Helvetica Neue',Arial,sans-serif);font-size:15px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;text-decoration:none;transition:transform .15s ease}.ds-pill-mint:hover{transform:translateY(-1px)}.ds-pill-mint:focus-visible{outline:2px solid #1878cf;outline-offset:2px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "search-input",
      "description": "Pill search; GET form to /projects?q=.",
      "html": "<form class=\"ds-search\" role=\"search\"><label class=\"ds-vh\" for=\"ds-q\">Search projects</label><input id=\"ds-q\" class=\"ds-search__input\" type=\"search\" placeholder=\"Search 2,762 projects, e.g. PyPSA, solar, wildfire\"><button class=\"ds-search__btn\" type=\"submit\">Search</button></form>",
      "css": ".ds-search{display:flex;flex-wrap:wrap;gap:12px}.ds-vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}.ds-search__input{flex:1 1 300px;min-height:52px;padding:0 20px;border:2px solid var(--color-black,#13262b);border-radius:999px;background:var(--color-bg,#fff);color:var(--color-text,#13262b);font-family:var(--font-body,'Helvetica Neue',Arial,sans-serif);font-size:16px}.ds-search__input::placeholder{color:#4d6166}.ds-search__input:focus-visible{outline:2px solid #1878cf;outline-offset:2px}.ds-search__btn{min-height:52px;padding:0 24px;border:2px solid #1878cf;border-radius:999px;background:#1878cf;color:#fff;font-family:var(--font-body,'Helvetica Neue',Arial,sans-serif);font-size:15px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;cursor:pointer}.ds-search__btn:hover{background:#145e9c;border-color:#145e9c}"
    },
    {
      "name": "Subcategory Pill",
      "kind": "chip",
      "refersTo": "sub-pill",
      "description": "Links into the directory filtered to a subcategory.",
      "html": "<a class=\"ds-sub-pill\" href=\"#\"><span class=\"ds-sub-pill__dot\" style=\"background:#51a362\"></span>Marine Life and Fishery<span class=\"ds-sub-pill__count\">69</span></a>",
      "css": ".ds-sub-pill{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:0 16px;border:1.5px solid var(--color-black,#13262b);border-radius:999px;background:var(--color-bg,#fff);color:var(--color-black,#13262b);font-family:var(--font-body,'Helvetica Neue',Arial,sans-serif);font-size:15px;text-decoration:none}.ds-sub-pill:hover{background:#e3eae8}.ds-sub-pill:focus-visible{outline:2px solid #1878cf;outline-offset:2px}.ds-sub-pill__dot{width:8px;height:8px;border-radius:50%}.ds-sub-pill__count{font-family:var(--font-mono,'IBM Plex Mono',monospace);font-size:12px;color:#4d6166}"
    },
    {
      "name": "Category Card",
      "kind": "card",
      "refersTo": "category-card",
      "description": "Toggle button in the explorer; pressed state fills silver and is mirrored on the ring.",
      "html": "<button class=\"ds-cat-card\" type=\"button\" aria-pressed=\"true\"><span class=\"ds-cat-card__top\"><span class=\"ds-cat-card__dot\" style=\"background:#51a362\"></span><span class=\"ds-label\">07</span></span><span class=\"ds-cat-card__name\">Biosphere</span><span class=\"ds-cat-card__meta\"><span>18 subcategories<br>443 projects</span></span></button>",
      "css": ".ds-cat-card{display:flex;flex-direction:column;gap:12px;width:240px;min-height:160px;padding:20px;border:2px solid var(--color-black,#13262b);border-radius:20px;background:var(--color-bg,#fff);color:var(--color-black,#13262b);font-family:var(--font-body,'Helvetica Neue',Arial,sans-serif);text-align:left;cursor:pointer;transition:transform .15s ease,background-color .15s ease}.ds-cat-card:hover{transform:translateY(-2px)}.ds-cat-card[aria-pressed=\"true\"]{background:#e3eae8}.ds-cat-card:focus-visible{outline:2px solid #1878cf;outline-offset:2px}.ds-cat-card__top{display:flex;align-items:center;gap:8px}.ds-cat-card__dot{width:14px;height:14px;border:2px solid var(--color-black,#13262b);border-radius:50%}.ds-label{font-family:var(--font-mono,'IBM Plex Mono',monospace);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#4d6166}.ds-cat-card__name{font-family:var(--font-heading,'Space Grotesk',Arial,sans-serif);font-size:21px;font-weight:600;line-height:1.15;text-transform:uppercase}.ds-cat-card__meta{font-size:14px;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Category Panel",
      "kind": "card",
      "refersTo": "category-panel",
      "description": "The picked category's subcategories, under a bar in its hue.",
      "html": "<div class=\"ds-panel\"><div class=\"ds-panel__bar\" style=\"background:#51a362\"></div><div class=\"ds-panel__body\"><h3 class=\"ds-panel__title\">Biosphere</h3></div></div>",
      "css": ".ds-panel{overflow:hidden;border:2px solid var(--color-black,#13262b);border-radius:24px;background:#f3f6f5}.ds-panel__bar{height:6px}.ds-panel__body{padding:28px}.ds-panel__title{margin:0;font-family:var(--font-heading,'Space Grotesk',Arial,sans-serif);font-size:26px;font-weight:600;text-transform:uppercase;color:#13262b}"
    },
    {
      "name": "Callout",
      "kind": "custom",
      "refersTo": "callout",
      "description": "Dark ink invitation in both themes, mint action and mint focus.",
      "html": "<div class=\"ds-callout\"><h2 class=\"ds-callout__title\">Start on ClimateTriage</h2><p class=\"ds-callout__body\">Open issues from projects on this map, ready for your first pull request.</p><a class=\"ds-callout__pill\" href=\"#\">Find an issue</a></div>",
      "css": ".ds-callout{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px;padding:48px;border-radius:28px;background:#13262b;color:#fff}.ds-callout__title{margin:0;font-family:var(--font-heading,'Space Grotesk',Arial,sans-serif);font-size:38px;font-weight:600;line-height:1.1;text-transform:uppercase;color:#fff}.ds-callout__body{max-width:520px;font-size:18px;color:#e3eae8}.ds-callout__pill{display:inline-flex;align-items:center;min-height:48px;padding:0 24px;border-radius:999px;border:2px solid #13262b;background:#47f6ad;color:#13262b;font-weight:700;font-size:15px;letter-spacing:.03em;text-transform:uppercase;text-decoration:none}.ds-callout__pill:focus-visible{outline:2px solid #47f6ad;outline-offset:2px}"
    },
    {
      "name": "Header Nav",
      "kind": "nav",
      "refersTo": "",
      "description": "Capitals nav; current page underlined 2px in brand blue at 8px offset.",
      "html": "<nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">Directory</a><a href=\"#\">Learning</a><a href=\"#\">About</a></nav>",
      "css": ".ds-nav{display:flex;gap:22px;padding:10px 0;border-bottom:1px solid #13262b}.ds-nav a{font-family:var(--font-body,'Helvetica Neue',Arial,sans-serif);font-size:14px;font-weight:500;letter-spacing:.03em;text-transform:uppercase;color:#13262b;text-decoration:none}.ds-nav a:hover{color:#145e9c}.ds-nav a[aria-current=\"page\"]{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:8px;text-decoration-color:#1878cf}.ds-nav a:focus-visible{outline:2px solid #1878cf;outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Campaign Map",
    "overview": "The ecosystem ring, sized by project count and coloured by category, is the most colourful thing on any screen; everything around it is ink on a white ground: 2px outlines, 1px rules, short titles in grotesk capitals and a single mint signal for contributing. Depth comes from lines and washes, not shadows. Dark theme is the same map on graphite, with the community strip and callout fixed in dark ink.",
    "keyCharacteristics": [
      "2px ink outlines on controls and cards; 1px ink rules between bands",
      "Space Grotesk capitals for short titles; sentence case for long ones",
      "Pills for every button and filter; 20px-radius cards; ringed category dots",
      "Brand blue for search, mint for contributing, category hues only for data",
      "Light by default; dark is opt-in"
    ],
    "rules": [
      {
        "name": "The Data Owns the Colour Rule",
        "body": "Category hues appear only where they stand for a category: ring, dots, the panel bar.",
        "section": "colors"
      },
      {
        "name": "The One Mint Rule",
        "body": "Mint marks the invitation to contribute and nothing else; never text on white.",
        "section": "colors"
      },
      {
        "name": "The Fixed Ink Rule",
        "body": "The community strip and callout are dark ink in both themes.",
        "section": "colors"
      },
      {
        "name": "The Short Capitals Rule",
        "body": "Capitals for short titles, buttons, nav and labels; article titles and reading text in sentence case.",
        "section": "typography"
      },
      {
        "name": "The Label Names a Thing Rule",
        "body": "The mono label names a figure, column, count or group; it does not introduce a heading.",
        "section": "typography"
      },
      {
        "name": "The Line, Not Shadow Rule",
        "body": "Separation is a 2px outline or 1px rule; hover lifts 1-2px.",
        "section": "elevation"
      },
      {
        "name": "The Ringed Dot Rule",
        "body": "A standalone category dot is ringed in 2px ink.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do draw controls and cards with the 2px ink line and separate bands with 1px ink rules.",
      "Do set short titles in Space Grotesk capitals and keep article titles in sentence case.",
      "Do keep category hues on data only, with ink labels.",
      "Do give every chart a reachable list alternative.",
      "Do keep the page search as the one primary action in the first viewport.",
      "Do take every figure from the data snapshot."
    ],
    "donts": [
      "Don't use shadows to separate surfaces.",
      "Don't use mint as text on white or outside the contribute invitation.",
      "Don't let the community strip or callout invert with the theme.",
      "Don't follow the OS colour scheme.",
      "Don't set long titles in capitals."
    ]
  }
}