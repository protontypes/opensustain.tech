@@ -0,0 +1,31 @@
+name: Notify opensustain.tech of README changes
+
+# Fires a repository_dispatch to protontypes/opensustain.tech whenever
+# README.md changes on main, so the new site's project directory (built from
+# this repo's README — see its DATA_CONTRACT.md) rebuilds shortly after a
+# project is added or edited here, instead of waiting for its weekly
+# schedule.
+#
+# Needs a secret named OST_TECH_DISPATCH_TOKEN: a fine-grained PAT scoped to
+# protontypes/opensustain.tech with "Contents: read and write" (repository
+# dispatch requires write access on the target repo) — the default
+# GITHUB_TOKEN can't dispatch events to a different repository. See
+# opensustain.tech's docs/migration/README.md for how to create and add it.
+on:
+  push:
+    branches: [main]
+    paths:
+      - "README.md"
+  workflow_dispatch:
+
+jobs:
+  notify:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Dispatch ost-readme-updated to opensustain.tech
+        run: |
+          curl -sS -f -X POST \
+            -H "Authorization: token ${{ secrets.OST_TECH_DISPATCH_TOKEN }}" \
+            -H "Accept: application/vnd.github.v3+json" \
+            https://api.github.com/repos/protontypes/opensustain.tech/dispatches \
+            -d '{"event_type":"ost-readme-updated"}'
