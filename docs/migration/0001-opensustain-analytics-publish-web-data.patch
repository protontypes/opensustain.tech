diff --git a/.github/workflows/publish-web-data.yml b/.github/workflows/publish-web-data.yml
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/.github/workflows/publish-web-data.yml
@@ -0,0 +1,53 @@
+name: Publish web data
+
+# Publishes web/public/data/*.json — the 13 analytics payloads
+# scripts/build_analytics_payloads.py regenerates from data/*.csv — to a
+# dedicated `data` branch, then tells opensustain.tech to rebuild against it.
+#
+# Runs after "Update OpenSustain Data" finishes (that workflow refreshes
+# data/*.csv from the open-sustainable-technology release, but does not
+# itself regenerate or publish the JSON payloads), on any push to main that
+# touches the payloads directly, and on demand.
+#
+# Needs a secret named OST_TECH_DISPATCH_TOKEN: a fine-grained PAT scoped to
+# protontypes/opensustain.tech with "Contents: read and write" (repository
+# dispatch requires write access on the target repo) — the default
+# GITHUB_TOKEN can't dispatch events to a different repository. See
+# opensustain.tech's docs/migration/README.md for how to create and add it.
+on:
+  workflow_run:
+    workflows: ["Update OpenSustain Data"]
+    types: [completed]
+  push:
+    branches: [main]
+    paths:
+      - "web/public/data/**"
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+jobs:
+  publish:
+    if: ${{ github.event_name != 'workflow_run' || github.event.workflow_run.conclusion == 'success' }}
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v4
+
+      - name: Publish web/public/data to the data branch
+        uses: peaceiris/actions-gh-pages@v4
+        with:
+          github_token: ${{ secrets.GITHUB_TOKEN }}
+          publish_dir: web/public/data
+          publish_branch: data
+          keep_files: false
+          commit_message: "data: publish web/public/data (${{ github.sha }})"
+
+      - name: Notify opensustain.tech to rebuild
+        run: |
+          curl -sS -f -X POST \
+            -H "Authorization: token ${{ secrets.OST_TECH_DISPATCH_TOKEN }}" \
+            -H "Accept: application/vnd.github.v3+json" \
+            https://api.github.com/repos/protontypes/opensustain.tech/dispatches \
+            -d '{"event_type":"analytics-data-updated"}'
